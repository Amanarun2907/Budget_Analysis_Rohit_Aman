# API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/budget_intelligence
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/budget_intelligence
# Redis
REDIS_URL=redis://localhost:6379/0
# App
APP_NAME=Budget Intelligence Platform
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Upload
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
# Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
